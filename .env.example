# ============================================
# FREE LOCAL FEATURES (No configuration needed)
# ============================================
# These work out of the box with default settings

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
ENVIRONMENT=development

# Frontend
FRONTEND_PORT=3000
FRONTEND_HOST=0.0.0.0

# ============================================
# OPTIONAL FREE API FEATURES
# ============================================
# These require free API keys but are completely optional

# Pexels API (Free stock images)
# Get free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay API (Free stock images)
# Get free key at https://pixabay.com/api/
PIXABAY_API_KEY=

# ============================================
# YOUTUBE OAUTH (Required for upload feature)
# ============================================
# Follow the setup guide in README.md to get these

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# ============================================
# LLM CONFIGURATION (Ollama)
# ============================================
# Ollama runs locally on your machine
# Download from https://ollama.ai

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# ============================================
# TTS CONFIGURATION (Piper)
# ============================================
# Piper runs locally
# Models downloaded automatically

PIPER_HOST=localhost
PIPER_PORT=8000

# ============================================
# VIDEO SETTINGS
# ============================================
VIDEO_OUTPUT_RESOLUTION=1080p
VIDEO_FPS=30
VIDEO_BITRATE=5000k
VIDEO_FORMAT=mp4

# ============================================
# STORAGE
# ============================================
STORAGE_PATH=./storage
TEMP_PATH=./temp
VIDEOS_PATH=./storage/videos
THUMBNAILS_PATH=./storage/thumbnails

# ============================================
# SCHEDULER (Optional)
# ============================================
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=UTC

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
